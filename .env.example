# Copy this file to .env and fill in your values.
# .env is git-ignored, so your keys never get committed.

# ---- Provider switch ----
# "azure" (default) or "openai"
LLM_PROVIDER=azure

# ---- Azure OpenAI ----
# Found in Azure Portal > your Azure OpenAI resource > Keys and Endpoint.
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure uses DEPLOYMENT names, not raw model names. These are the names you
# gave the deployments in Azure AI Foundry / Azure OpenAI Studio, not
# "text-embedding-3-small" or "gpt-4o-mini" themselves.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ---- OpenAI (used only if LLM_PROVIDER=openai) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
